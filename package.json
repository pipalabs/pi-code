{
  "name": "@aelinrezende/pipa",
  "version": "2.7.0",
  "private": false,
  "type": "module",
  "description": "Pi package que carrega a extensão Pipa",
  "main": "./index.js",
  "files": [
    "index.js",
    "skills/**/*",
    "prompts/**/*",
    "teammates/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelinrezende/pipa.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.js"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "packages": [
      "npm:@juicesharp/rpiv-ask-user-question",
      "npm:@dietrichgebert/ponytail"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "build": "bun run ./scripts/build-ext.ts",
    "ts-check": "tsc --project tsconfig.pipa-core.json --noEmit"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-notifier": "^10.0.1",
    "get-windows": "^9.3.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs",
    "get-windows",
    "esbuild"
  ],
  "packageManager": "bun@1.3.14",
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}